// Санал, санаачилгын цахим платформ — өгөгдлийн сангийн схем.
//
// Тайлангийн Хүснэгт 3.1 (Бүлэг 3.4)-д тодорхойлсон 12 хүснэгтийг бүрэн
// хэрэгжүүлсэн: school, unit, app_user, category, request, initiative,
// support, response, status_history, notification, setting, academic_break.
//
// Үүн дээр нэмэлтээр 5 хүснэгт: session (httpOnly cookie-ийн сесс),
// request_message (илгээгч ↔ нэгжийн харилцан яриа), comment, comment_report
// (нээлттэй санаачилгын хэлэлцүүлэг), audit_log (төлөв биш — тохиргоо, эрхийн
// өөрчлөлтийн бүртгэл, NFR-07).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Холболтын URL нь Prisma 7-оос эхлэн schema дотор байхаа больсон —
// prisma.config.ts (CLI) болон PrismaPg adapter (ажиллах үед) хариуцна.
datasource db {
  provider = "postgresql"
}

/* ═══ Тоочсон төрлүүд ════════════════════════════════════════════ */

/// Гишүүний төрөл — SSO-оос ирнэ. Хэн болохыг заана.
enum MemberType {
  STUDENT
  TEACHER
  STAFF
}

/// Системийн эрх (RBAC, FR-03). Гишүүний төрлөөс ТУСДАА ойлголт:
/// багш нэгэн зэрэг модератор байж болно.
enum Role {
  MEMBER
  UNIT_STAFF
  MODERATOR
  ADMIN
}

/// Хаалттай сувгийн хүсэлтийн төрөл. Хуулийн хугацааг энэ тодорхойлно:
/// гомдол 30 хоног (+30 сунгалт), санал 90 хоног.
enum RequestKind {
  SUGGESTION
  COMPLAINT
}

/// Санал, гомдлын төлөв — тайлангийн Зураг 2.8-ын төлөвийн машин.
enum RequestStatus {
  SUBMITTED // Илгээсэн
  ROUTED // Чиглүүлсэн — хариуцсан нэгжид хүрсэн
  AT_MODERATOR // Модераторт очсон — «Бусад» ангилал эсвэл буцаагдсан
  IN_PROGRESS // Шийдвэрлэж буй — нэгж нээж үзсэн
  ANSWERED // Хариулсан
  OVERDUE // Хугацаа хэтэрсэн
  CLOSED // Хаагдсан
  CONVERTED // Санаачилга болсон
}

/// Санаачилгын төлөв — тайлангийн Зураг 2.9-ийн төлөвийн машин.
/// COLLECTING ба PAUSED нь «Нээлттэй» нийлмэл төлөвийн хоёр дэд төлөв.
enum InitiativeStatus {
  DRAFT // Ноорог
  IN_REVIEW // Хянагдаж буй — модератор
  COLLECTING // Нээлттэй · Цуглуулж буй
  PAUSED // Нээлттэй · Түр зогссон (хичээлийн амралт)
  REJECTED // Татгалзсан
  THRESHOLD_MET // Босго давсан — нэгжид шилжсэн
  EXPIRED // Хугацаа дууссан — босгод хүрээгүй
  ANSWERED // Хариулсан
  OVERDUE // Хугацаа хэтэрсэн
  HIDDEN // Нуусан — дүрэм зөрчсөн
  ARCHIVED // Архивласан
}

/// Санаачилгын хамрах хүрээ (FR-10). N-ийг энэ хүрээгээр тооцно.
enum Scope {
  UNIVERSITY // Бүх ШУТИС
  SCHOOL // Нэг бүрэлдэхүүн сургууль
  CLASS // Тодорхой бүлэг — сургууль + курс
}

/// Хамрах бүлэг — хэн дэмжих эрхтэй вэ. Scope-той хамт N-ийг тодорхойлно.
enum Audience {
  ALL // Оюутан, багш, ажилтан
  STUDENT
  TEACHER
  STAFF
  EMPLOYEE // Багш + ажилтан
}

/// Нэгжийн өгсөн албан хариуны шинж (FR-16).
/// Хариу нь эцсийн шийдвэр байх албагүй — тайлангийн Бүлэг 1.1.4.
enum ResponseOutcome {
  ACCEPTED // Хүлээн авч, хэрэгжүүлнэ
  EXPLAINED // Өөрчлөлт шаардлагагүй — тайлбар
  SCHEDULED // Хэрэгжүүлэх хугацаа товлосон
  DECLINED // Татгалзсан
}

/// Мэдэгдлийн төрөл (FR-28).
enum NotificationKind {
  STATUS_CHANGED
  RESPONSE_POSTED
  THRESHOLD_MET
  DUE_SOON
  OVERDUE
  MODERATION_NEEDED
  REQUEST_ROUTED
}

/* ═══ Лавлах хүснэгтүүд ══════════════════════════════════════════ */

/// Бүрэлдэхүүн сургууль. Хэрэглэгчийн харьяалал ба санаачилгын хамрах
/// хүрээнд ашиглагдана (тайлангийн Хүснэгт 2.26-гийн N).
model School {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // МХТС, БАС, ЭХС ...
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       User[]
  initiatives Initiative[]

  @@map("school")
}

/// Санал, гомдол хүлээн авч хариулах нэгж (Сургалтын алба гэх мэт).
model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  email     String   @default("")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  categories  Category[]
  staff       User[]
  requests    Request[]
  initiatives Initiative[]

  @@map("unit")
}

/// Ангилал. unitId-аар хариуцсан нэгж рүү чиглүүлнэ (FR-05).
/// unitId хоосон бол хүсэлт модераторт очно («Бусад» ангилал).
/// Админ код өөрчлөхгүйгээр энэ холбоосыг удирдана (FR-23, NFR-13).
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  hint      String   @default("")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  unitId    String?  @map("unit_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  unit        Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  requests    Request[]
  initiatives Initiative[]

  @@index([active, sortOrder])
  @@map("category")
}

/* ═══ Хэрэглэгч ба сесс ══════════════════════════════════════════ */

/// Хэрэглэгч. ssoSub нь SSO-ийн давтагдашгүй танигч — «нэг хүн нэг бүртгэл»
/// зарчим үүн дээр тулгуурладаг (тайлангийн Бүлэг 1.1.1).
model User {
  id          String     @id @default(uuid()) @db.Uuid
  ssoSub      String     @unique @map("sso_sub")
  code        String     @unique // оюутны код / ажилтны дугаар
  name        String
  email       String
  memberType  MemberType @default(STUDENT) @map("member_type")
  role        Role       @default(MEMBER)
  schoolId    String?    @map("school_id") @db.Uuid
  unitId      String?    @map("unit_id") @db.Uuid // зөвхөн UNIT_STAFF
  position    String     @default("") // мэргэжил / тэнхим / албан тушаал
  year        Int        @default(0) // зөвхөн оюутны курс
  active      Boolean    @default(true)
  consentAt   DateTime?  @map("consent_at") @db.Timestamptz(6) // FR-02
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)

  school           School?         @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  unit             Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  sessions         Session[]
  requests         Request[]
  initiatives      Initiative[]
  supports         Support[]
  responses        Response[]
  statusChanges    StatusHistory[]
  notifications    Notification[]
  comments         Comment[]
  commentReports   CommentReport[]
  requestMessages  RequestMessage[]

  @@index([active, memberType, schoolId, year])
  @@map("app_user")
}

/// Сесс. httpOnly, Secure cookie-д зөвхөн token хадгалагдана (NFR-04).
model Session {
  token     String   @id
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("session")
}

/* ═══ Хаалттай суваг: санал, гомдол ══════════════════════════════ */

/// Хаалттай сувгийн хүсэлт. Зөвхөн гаргагч, хариуцсан нэгж, модератор
/// харна (FR-07, NFR-06).
///
/// dueAt — хариу өгөх хуулийн эцсийн хугацаа. Хуанлийн өдрөөр тоологдож,
/// хичээлийн амралтаар ЗОГСОХГҮЙ (тайлангийн 2.11.2). Нэгж солигдсон ч
/// дахин эхлэхгүй — submittedAt-аас тоологдоно (TC-07).
model Request {
  id         Int           @id @default(autoincrement())
  kind       RequestKind
  status     RequestStatus @default(SUBMITTED)
  title      String
  body       String
  categoryId String        @map("category_id") @db.Uuid
  unitId     String?       @map("unit_id") @db.Uuid
  authorId   String?       @map("author_id") @db.Uuid
  anonymous  Boolean       @default(false)

  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  dueAt       DateTime  @map("due_at") @db.Timestamptz(6)
  extended    Boolean   @default(false) // FR-17 — нэг л удаа сунгана
  extendedAt  DateTime? @map("extended_at") @db.Timestamptz(6)
  openedAt    DateTime? @map("opened_at") @db.Timestamptz(6)
  answeredAt  DateTime? @map("answered_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  rating      Int? // 1..3, илгээгчийн үнэлгээ

  /// FR-09 — нэг гомдол хамгийн ихдээ нэг санаачилга болж хөрвөнө.
  convertedInitiativeId Int? @unique @map("converted_initiative_id")

  category            Category         @relation(fields: [categoryId], references: [id])
  unit                Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  author              User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  convertedInitiative Initiative?      @relation("RequestConversion", fields: [convertedInitiativeId], references: [id], onDelete: SetNull)
  responses           Response[]
  statusHistory       StatusHistory[]
  messages            RequestMessage[]

  /// Нэгжийн самбарын хайлт — тайлангийн idx_request_unit_due
  @@index([unitId, status, dueAt])
  @@index([authorId])
  @@map("request")
}

/// Илгээгч ↔ нэгжийн харилцан яриа. internal = true бол нэгжийн дотоод
/// тэмдэглэл, илгээгчид харагдахгүй.
model RequestMessage {
  id        Int      @id @default(autoincrement())
  requestId Int      @map("request_id")
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  internal  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("request_message")
}

/* ═══ Нээлттэй суваг: санаачилга ═════════════════════════════════ */

/// Нийтийн санаачилга.
///
/// scopeSizeN  — батлах үед тоологдсон идэвхтэй гишүүдийн тоо N
/// threshold   — батлах үед ТООЦООД ХАДГАЛСАН босго B. Дараа нь параметр
///               өөрчлөгдсөн ч энэ тоо хөдлөхгүй (FR-11, тайлангийн 2.11.1).
/// supportCount— дэмжлэгийн тоолуур. support хүснэгттэй транзакцаар
///               хамт шинэчлэгдэнэ (2.11.3).
model Initiative {
  id        Int              @id @default(autoincrement())
  status    InitiativeStatus @default(DRAFT)
  title     String
  summary   String
  body      String

  categoryId String   @map("category_id") @db.Uuid
  scope      Scope    @default(UNIVERSITY)
  audience   Audience @default(ALL)
  schoolId   String?  @map("school_id") @db.Uuid // scope = SCHOOL | CLASS
  classYear  Int?     @map("class_year") // scope = CLASS

  authorId String? @map("author_id") @db.Uuid
  unitId   String? @map("unit_id") @db.Uuid // босго давсны дараа чиглүүлнэ

  scopeSizeN   Int @default(0) @map("scope_size_n")
  threshold    Int @default(0)
  supportCount Int @default(0) @map("support_count")

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt   DateTime? @map("submitted_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  collectUntil  DateTime? @map("collect_until") @db.Timestamptz(6)
  thresholdAt   DateTime? @map("threshold_at") @db.Timestamptz(6)
  responseDueAt DateTime? @map("response_due_at") @db.Timestamptz(6)
  answeredAt    DateTime? @map("answered_at") @db.Timestamptz(6)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)

  /// Модераторын шийдвэр. Татгалзах, нуух, хамрах хүрээ засах бүрт
  /// шалтгаан заавал бичигдэнэ (FR-19, FR-20, FR-22).
  moderatorId   String?   @map("moderator_id") @db.Uuid
  moderatedAt   DateTime? @map("moderated_at") @db.Timestamptz(6)
  reasonCode    String?   @map("reason_code")
  moderatorNote String?   @map("moderator_note")

  category      Category        @relation(fields: [categoryId], references: [id])
  school        School?         @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  unit          Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  author        User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  supports      Support[]
  responses     Response[]
  statusHistory StatusHistory[]
  comments      Comment[]
  fromRequest   Request?        @relation("RequestConversion")

  /// Хугацаа шалгах цаг хэмжигчийн индекс — тайлангийн idx_initiative_status
  @@index([status, collectUntil])
  @@index([status, responseDueAt])
  @@index([authorId])
  @@map("initiative")
}

/// Дэмжлэг. (initiativeId, userId) хос нь үндсэн түлхүүр тул нэг хүн нэг
/// санаачилгыг нэг л удаа дэмжинэ — давхардлыг өгөгдлийн сангийн түвшинд
/// хаана (FR-12, тайлангийн 2.11.3, TC-11).
model Support {
  initiativeId Int      @map("initiative_id")
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  initiative Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([initiativeId, userId])
  @@map("support")
}

/// Нээлттэй санаачилгын хэлэлцүүлэг.
model Comment {
  id           Int       @id @default(autoincrement())
  initiativeId Int       @map("initiative_id")
  authorId     String?   @map("author_id") @db.Uuid
  body         String
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  editedAt     DateTime? @map("edited_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  hiddenAt     DateTime? @map("hidden_at") @db.Timestamptz(6)

  initiative Initiative      @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  author     User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reports    CommentReport[]

  @@index([initiativeId])
  @@map("comment")
}

model CommentReport {
  commentId Int      @map("comment_id")
  userId    String   @map("user_id") @db.Uuid
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
  @@map("comment_report")
}

/* ═══ Хариу, түүх, мэдэгдэл ══════════════════════════════════════ */

/// Нэгжийн албан хариу. Хүсэлт ЭСВЭЛ санаачилгын яг нэгтэй холбогдоно —
/// тайлангийн chk_target хязгаарлалт.
model Response {
  id           Int             @id @default(autoincrement())
  requestId    Int?            @map("request_id")
  initiativeId Int?            @map("initiative_id")
  outcome      ResponseOutcome
  body         String
  dueDate      DateTime?       @map("due_date") @db.Timestamptz(6) // SCHEDULED үед
  responderId  String?         @map("responder_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  request    Request?    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  initiative Initiative? @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  responder  User?       @relation(fields: [responderId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([initiativeId])
  @@map("response")
}

/// Төлөвийн өөрчлөлт бүр — хэн, хэзээ, ямар шалтгаанаар (FR-29, NFR-07).
/// Ил тод байдал болон аудитын үүрэгтэй.
model StatusHistory {
  id           Int      @id @default(autoincrement())
  requestId    Int?     @map("request_id")
  initiativeId Int?     @map("initiative_id")
  fromStatus   String?  @map("from_status")
  toStatus     String   @map("to_status")
  actorId      String?  @map("actor_id") @db.Uuid
  actorLabel   String   @default("систем") @map("actor_label")
  reason       String   @default("")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  request    Request?    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  initiative Initiative? @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([initiativeId])
  @@map("status_history")
}

/// Хэрэглэгчийн мэдэгдэл (FR-28).
model Notification {
  id           Int              @id @default(autoincrement())
  userId       String           @map("user_id") @db.Uuid
  kind         NotificationKind
  title        String
  body         String           @default("")
  href         String           @default("")
  readAt       DateTime?        @map("read_at") @db.Timestamptz(6)
  emailedAt    DateTime?        @map("emailed_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notification")
}

/* ═══ Тохиргоо ═══════════════════════════════════════════════════ */

/// p, T_min, q болон хугацааны параметрүүд. key–value, jsonb.
/// Админ самбараас код өөрчлөхгүйгээр тохируулна (FR-24, NFR-13).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String   @default("") @map("updated_by")

  @@map("setting")
}

/// Хичээлийн амралтын үеүд (FR-25). Дотоод журмын хугацааг энэ хооронд
/// зогсооно; хуулийн хугацааг ЗОГСООХГҮЙ (тайлангийн 2.11.2).
model AcademicBreak {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([startsOn, endsOn])
  @@map("academic_break")
}

/// Тохиргоо, эрхийн өөрчлөлт зэрэг төлөвт хамаарахгүй удирдлагын үйлдэл.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorLabel String   @default("систем") @map("actor_label")
  action     String
  entity     String
